.page-shell {
  min-height: 100vh;
  padding: 88rpx 48rpx 64rpx;
  background: #101923;
}

.hero {
  display: flex;
  flex-direction: column;
}

.eyebrow {
  color: #61d4c5;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.title {
  margin-top: 18rpx;
  color: #f4f7fb;
  font-size: 68rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle {
  max-width: 620rpx;
  margin-top: 20rpx;
  color: #8fa2b5;
  font-size: 28rpx;
  line-height: 1.65;
}

.flight-panel {
  position: relative;
  height: 420rpx;
  margin-top: 64rpx;
  overflow: hidden;
  border: 1rpx solid #243645;
  border-radius: 24rpx;
  background: #172633;
}

.skyline {
  position: absolute;
  right: -10%;
  bottom: 0;
  width: 120%;
  height: 160rpx;
  background: #203847;
  clip-path: polygon(0 70%, 12% 58%, 22% 74%, 35% 42%, 48% 66%, 59% 35%, 76% 61%, 87% 46%, 100% 67%, 100% 100%, 0 100%);
}

.skyline-back {
  bottom: 70rpx;
  opacity: 0.5;
  transform: scale(1.15);
}

.skyline-front {
  background: #10212d;
}

.plane {
  position: absolute;
  top: 120rpx;
  left: 50%;
  width: 112rpx;
  height: 38rpx;
  border-radius: 70% 35% 35% 70%;
  background: #61d4c5;
  box-shadow: 0 0 44rpx rgba(97, 212, 197, 0.5);
  transform: translateX(-50%) rotate(-12deg);
}

.plane::before,
.plane::after {
  position: absolute;
  display: block;
  width: 60rpx;
  height: 18rpx;
  background: #61d4c5;
  content: "";
}

.plane::before {
  top: 20rpx;
  left: 24rpx;
  border-radius: 0 0 8rpx 8rpx;
  transform: skewX(-34deg);
}

.plane::after {
  top: -8rpx;
  left: 52rpx;
  width: 32rpx;
  height: 16rpx;
  border-radius: 8rpx 8rpx 0 0;
  transform: skewX(30deg);
}

.panel-copy {
  position: absolute;
  right: 32rpx;
  bottom: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.panel-label,
.stat-label {
  color: #71889c;
  font-size: 24rpx;
}

.panel-status {
  margin-top: 6rpx;
  color: #f4f7fb;
  font-size: 30rpx;
  font-weight: 600;
}

.stats-row {
  display: flex;
  margin: 32rpx 0 48rpx;
  padding: 0 8rpx;
}

.stat-item {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.stat-item + .stat-item {
  border-left: 1rpx solid #2a3d4c;
  padding-left: 36rpx;
}

.stat-value {
  margin-top: 8rpx;
  color: #f4f7fb;
  font-size: 34rpx;
  font-weight: 600;
}

.primary-button,
.secondary-button {
  height: 96rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.primary-button {
  color: #10212d;
  background: #61d4c5;
}

.secondary-button {
  color: #d5e5ed;
  background: #203847;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.hint {
  display: block;
  margin-top: 22rpx;
  color: #63798b;
  font-size: 23rpx;
  text-align: center;
}
